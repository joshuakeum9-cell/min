{
  "name": "min",
  "version": "1.4.0",
  "private": true,
  "description": "Meeting notes that never leave your machine.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "m0": "node m0/run-all.js",
    "m0:models": "node m0/lib/models.js",
    "m0:hw": "node m0/lib/hardware.js",
    "m0:asr": "node m0/bench-asr.js",
    "m0:llm": "node m0/bench-llm.js",
    "m0:eval": "node m0/eval-counterfactual.js",
    "m0:capture": "electron m0/capture-probe",
    "start": "electron .",
    "transcribe": "node app/transcribe.js",
    "prompt": "node app/prompt.js",
    "dist": "electron-builder --win --publish never",
    "pack": "electron-builder --dir",
    "mcpb": "node mcp/build-bundle.js",
    "mcp": "node mcp/server.js",
    "mcp:test": "node mcp/smoke-test.js",
    "icon": "python tools/make-icon.py",
    "smoke": "node tools/smoke.js",
    "smoke:packaged": "node tools/smoke.js --packaged",
    "test": "node app/calendar.test.js && node app/fillers.test.js && node app/recording.test.js && node app/meeting-alerts.test.js && node app/mic-watch.test.js && node tools/smoke.js",
    "test:live": "node app/live.test.js --fast"
  },
  "dependencies": {
    "sherpa-onnx-node": "1.13.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "electron": "44.1.1",
    "electron-builder": "^26.0.0",
    "node-llama-cpp": "3.20.0",
    "zod": "^4.5.4"
  },
  "main": "app/main.js",
  "productName": "MIN",
  "author": "Joshua Keum",
  "license": "MIT",
  "build": {
    "appId": "dev.joshuakeum.min",
    "productName": "MIN",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "m0/lib/**/*",
      "package.json",
      "!**/*.map",
      "!app/**/*.test.js",
      "!node_modules/@modelcontextprotocol/**",
      "!tools/**",
      "!build/**"
    ],
    "asarUnpack": [
      "app/asr-worker.js",
      "app/asr-live-worker.js",
      "**/node_modules/sherpa-onnx-*/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false,
      "artifactName": "MIN-Setup.${ext}",
      "executableName": "MIN-Notes"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MIN",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    }
  }
}
